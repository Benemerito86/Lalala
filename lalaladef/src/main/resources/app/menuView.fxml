<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<Pane prefHeight="1080" prefWidth="1920" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MenuController">

    <ImageView fitHeight="1080" fitWidth="1920" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@../menu/menuVacioOk.png" />
        </image>
    </ImageView>


    <Label fx:id="welcomeText" />
   <ImageView fitHeight="315.0" fitWidth="591.0" layoutX="770.0" layoutY="607.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@../img/botonSalir.png" />
      </image>
   </ImageView>
    <Button fx:id="exitButton" layoutX="845.0" layoutY="687.0" onAction="#handleExit" opacity="0.22" prefHeight="153.0" prefWidth="230.0" text="Salir">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor></Button>
   <ImageView fitHeight="277.0" fitWidth="410.0" layoutX="803.0" layoutY="305.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@../img/botonJugar.png" />
      </image>
   </ImageView>
    <Button fx:id="playButton" layoutX="845.0" layoutY="424.0" onAction="#handlePlay" opacity="0.4" prefHeight="130.0" prefWidth="230.0" text="Jugar">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor></Button>
   <ImageView fitHeight="348.0" fitWidth="776.0" layoutX="563.0" layoutY="106.0" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@../menu/cartel.png" />
        </image>
    </ImageView>

</Pane>

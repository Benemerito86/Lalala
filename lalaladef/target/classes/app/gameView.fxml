<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.GameController"
            fx:id="rootPane"
            onMouseClicked="#clickImagen"
            style="-fx-background-color: black;">

    <!-- FONDO PRINCIPAL -->
    <ImageView fx:id="fondo"
               preserveRatio="false"
               pickOnBounds="true" />

    <!-- LALA COMO SPRITE INDEPENDIENTE -->
    <ImageView fx:id="lalaSprite"
               layoutX="700"
               layoutY="430"
               fitWidth="260"
               preserveRatio="true"
               pickOnBounds="true" />

    <!-- OVERLAY PARA NIÑOS (mensajes simpáticos) -->
    <AnchorPane fx:id="overlay"
                style="-fx-background-color: rgba(0,0,0,0.65);"
                visible="false">

        <Label fx:id="overlayTexto"
               layoutX="200"
               layoutY="150"
               prefWidth="800"
               prefHeight="200"
               text="Mensaje"
               style="-fx-font-size: 48px;
                      -fx-font-weight: bold;
                      -fx-text-fill: yellow;
                      -fx-text-alignment: center;"
               wrapText="true" />

        <Button text="Cerrar"
                onAction="#cerrarOverlay"
                layoutX="500"
                layoutY="380"
                prefWidth="200"
                style="-fx-font-size: 22px;
                       -fx-font-weight: bold;
                       -fx-background-color: #ffffff;
                       -fx-text-fill: #333;" />
    </AnchorPane>

    <!--  BOTÓN VOLVER MEJORADO  -->
    <Button fx:id="btnVolver"
            text="🔙 ¡Volver!"
            onAction="#volverMenu"
            layoutX="30"
            layoutY="30"
            prefWidth="160"
            prefHeight="50"
            style="
                -fx-font-size: 22px;
                -fx-font-weight: bold;
                -fx-background-color: linear-gradient(to bottom, #ff9a9e, #fad0c4);
                -fx-text-fill: #5d4037;
                -fx-background-radius: 25;
                -fx-border-color: #ff6b6b;
                -fx-border-width: 2;
                -fx-border-radius: 25;
                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 2, 2);"
            onMouseEntered="#onHoverEnter"
            onMouseExited="#onHoverExit" />

</AnchorPane>
